    {
      "id": 12,
      "type": "row",
      "title": "Latency / Service Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Average Read Time",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(node_disk_read_time_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]) / clamp_min(rate(node_disk_reads_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]), 1)",
          "legendFormat": "{{instance}} {{device}} read",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.03 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Average Write Time",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "rate(node_disk_write_time_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]) / clamp_min(rate(node_disk_writes_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]), 1)",
          "legendFormat": "{{instance}} {{device}} write",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.03 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "I/O Utilization & Queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Disk I/O Time %",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Weighted I/O Time",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "targets": [
        {
          "expr": "rate(node_disk_io_time_weighted_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "legendFormat": "{{instance}} {{device}} weighted",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Top I/O Consumers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 19,
      "type": "barchart",
      "title": "Top Devices by Throughput",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 42 },
      "targets": [
        {
          "expr": "topk(15, sum by (instance, device) (rate(node_disk_read_bytes_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]) + rate(node_disk_written_bytes_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])))",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "Top Devices by I/O Time %",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 42 },
      "targets": [
        {
          "expr": "topk(15, rate(node_disk_io_time_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Disk Device Detail",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 51 },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "rate(node_disk_reads_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "rate(node_disk_writes_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "rate(node_disk_io_time_seconds_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Read Bps" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Write Bps" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*IOPS.*" },
            "properties": [
              { "id": "unit", "value": "iops" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "I/O Time %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "job": true
            },
            "renameByName": {
              "instance": "Instance",
              "device": "Device",
