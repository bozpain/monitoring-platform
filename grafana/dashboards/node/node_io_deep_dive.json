    {
      "id": 11,
      "type": "timeseries",
      "title": "Read / Write IOPS by Device",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "sum by (instance, device) (rate(node_disk_reads_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "{{instance}} {{device}} read iops",
          "refId": "A"
        },
        {
          "expr": "sum by (instance, device) (rate(node_disk_writes_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
