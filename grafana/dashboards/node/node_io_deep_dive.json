        {
          "expr": "sum by (instance, device) (rate(node_disk_written_bytes_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "{{instance}} {{device}} write",
          "refId": "B"
