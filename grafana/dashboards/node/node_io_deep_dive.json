      "targets": [
        {
          "expr": "sum by (instance) (rate(node_disk_reads_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "{{instance}} read iops",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(node_disk_writes_completed_total{job=\"node\", instance=~\"$instance\", device=~\"$device\", device!~\"loop.*|ram.*\"}[5m]))",
