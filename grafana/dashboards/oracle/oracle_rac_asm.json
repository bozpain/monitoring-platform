{
  "title": "06 - Oracle RAC / ASM",
  "uid": "oracle-rac-asm",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["oracle", "rac", "asm"],
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(up{job=\"oracle\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RAC Instances",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(oracle_rac_instance_status_value{instance=~\"$instance\"})"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RAC Active Sessions",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(oracle_rac_active_sessions_value{instance=~\"$instance\"})"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RAC Blocked Sessions",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(oracle_rac_blocked_sessions_value{instance=~\"$instance\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ASM Critical > 90%",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(oracle_asm_diskgroup_usage_used_percent{instance=~\"$instance\"} > 90)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "RAC Instance Status",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "oracle_rac_instance_status_value{instance=~\"$instance\"}",
          "legendFormat": "{{instance_name}} {{host_name}} {{status}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RAC Active Sessions by Instance",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (instance_name) (oracle_rac_active_sessions_value{instance=~\"$instance\"})",
          "legendFormat": "{{instance_name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAC Blocked Sessions by Instance",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (instance_name) (oracle_rac_blocked_sessions_value{instance=~\"$instance\"})",
          "legendFormat": "{{instance_name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "RAC Wait Class",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sort_desc(sum by (instance_name, wait_class) (oracle_rac_wait_class_value{instance=~\"$instance\"}))",
          "legendFormat": "{{instance_name}} {{wait_class}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showValue": "always"
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Global Cache Waits",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sort_desc(sum by (instance_name, event) (oracle_rac_gc_waits_value{instance=~\"$instance\"}))",
          "legendFormat": "{{instance_name}} {{event}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showValue": "always"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Oracle Services",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "oracle_services_status_value{instance=~\"$instance\"}",
          "legendFormat": "inst={{inst_id}} service={{name}} network={{network_name}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "ASM Diskgroup Usage",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sort_desc(oracle_asm_diskgroup_usage_used_percent{instance=~\"$instance\"})",
          "legendFormat": "{{name}} {{state}} {{type}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "ASM Diskgroup Used % Trend",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "oracle_asm_diskgroup_usage_used_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "ASM Operation / Rebalance",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "oracle_asm_operation_value{instance=~\"$instance\"}",
          "legendFormat": "group={{group_number}} operation={{operation}} state={{state}} power={{power}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}
