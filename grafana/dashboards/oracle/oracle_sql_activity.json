{
  "title": "04 - Oracle SQL Activity",
  "uid": "oracle-sql-activity",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "tags": [
    "oracle",
    "sql",
    "performance"
  ],
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Open DPA Repository",
      "type": "link",
      "url": "/d/oracle-dpa-repository"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(up{job=\"oracle\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "label": "instance",
        "definition": "label_values(up{job=\"oracle\"}, instance)",
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Top SQL by Elapsed Time Rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_elapsed_seconds_per_sec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top SQL by CPU Time Rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_cpu_seconds_per_sec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top SQL by Buffer Gets / Exec",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_buffer_gets_per_exec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top SQL by Disk Reads / Exec",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_disk_reads_per_exec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top SQL by Executions / Sec",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_executions_per_sec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top SQL by Rows / Exec",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_rows_per_exec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top SQL by Parse Calls / Sec",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(20, sort_desc(oracle:sql_parse_calls_per_sec:rate5m{instance=~\"$instance\"}))",
          "legendFormat": "{{sql_id}} plan={{plan_hash_value}} module={{module}} service={{service_name}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top SQL Version Count (Cursor Issues)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sort_desc(oracledb_oracle_top_sql_version_count_value{instance=~\"$instance\"})",
          "legendFormat": "{{sql_id}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "SQL Plan Hash Mapping",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "oracledb_oracle_sql_plan_hash_value{instance=~\"$instance\"}",
          "legendFormat": "sql={{sql_id}} plan={{plan_hash_value}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sql_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open SQL in DPA Repository",
                    "url": "/d/oracle-dpa-repository?var-sql_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "SQL Plan Change Candidates",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sort_desc(oracle:sql_plan_count{instance=~\"$instance\"})",
          "legendFormat": "{{sql_id}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Wait-to-SQL Attribution",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(30, sort_desc(oracle:active_sessions_by_sql_wait{instance=~\"$instance\"}))",
          "legendFormat": "sql={{sql_id}} wait={{event}} module={{module}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Elapsed Time Rate by Module",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(15, sort_desc(sum by (module) (oracle:sql_elapsed_seconds_per_sec:rate5m{instance=~\"$instance\"})))",
          "legendFormat": "{{module}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showValue": "always"
      }
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Elapsed Time Rate by Service",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(15, sort_desc(sum by (service_name) (oracle:sql_elapsed_seconds_per_sec:rate5m{instance=~\"$instance\"})))",
          "legendFormat": "{{service_name}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showValue": "always"
      }
    }
  ]
}
