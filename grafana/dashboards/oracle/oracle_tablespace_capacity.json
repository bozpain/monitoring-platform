      "targets": [
        {
          "expr": "sort_desc(oracledb_oracle_temp_usage_used_percent{instance=~\"$db_host\"})",
          "legendFormat": "{{instance}} {{tablespace_name}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "FRA Usage by File Type",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sort_desc(oracledb_oracle_fra_usage_used_percent{instance=~\"$db_host\"})",
          "legendFormat": "{{instance}} {{file_type}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "TEMP Used % Trend",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "oracledb_oracle_temp_usage_used_percent{instance=~\"$db_host\"}",
          "legendFormat": "{{instance}} {{tablespace_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "FRA Used % Trend",
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "oracledb_oracle_fra_usage_used_percent{instance=~\"$db_host\"}",
          "legendFormat": "{{instance}} {{file_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
