# Oracle DPA sampler runtime configuration.
# Installed to /monitoring/dpa/conf/dpa_sampler.env.

# Oracle connection for the monitored database.
# python-oracledb thin mode supports host:port/service_name.
DPA_ORACLE_USER=monitoring_user
DPA_ORACLE_PASSWORD=CHANGE_ME
DPA_ORACLE_DSN=db-host:1521/service_name

# Logical metadata used in PostgreSQL and Grafana filters.
DPA_DB_UNIQUE_NAME=oracle-prod-01
DPA_APP=unknown
DPA_TIER=uat
DPA_OWNER=dba

# PostgreSQL repository connection.
DPA_POSTGRES_DSN="host=localhost port=5432 dbname=dpa_repository user=dpa_app password=CHANGE_ME"

# Sampling controls.
DPA_SAMPLE_SECONDS=1
DPA_SQL_TOP_N=50
DPA_PLAN_TOP_N=20
DPA_CHANGE_LOOKBACK_MINUTES=15
DPA_RETENTION_DAYS=35
DPA_ENABLE_PLAN_SNAPSHOT=true
DPA_ENABLE_OBJECT_STATS=true
DPA_ENABLE_CHANGE_EVENTS=true
DPA_ENABLE_ADVISORY=true
