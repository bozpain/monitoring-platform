# MSSQL DPA sampler environment.
# Install to /monitoring/dpa/conf/mssql-<target>.env and replace CHANGE_ME values.

DPA_MSSQL_HOST=mssql-host
DPA_MSSQL_PORT=1433
DPA_MSSQL_USER=monitoring_user
DPA_MSSQL_PASSWORD=CHANGE_ME
DPA_MSSQL_DATABASE=master
DPA_MSSQL_INSTANCE_NAME=mssql-prod-01

DPA_APP=app-name
DPA_TIER=sit
DPA_OWNER=team-name

DPA_POSTGRES_DSN="host=localhost port=5432 dbname=dpa_repository user=dpa_app password=CHANGE_ME"

DPA_SAMPLE_SECONDS=1
DPA_SQL_TOP_N=50
DPA_PLAN_TOP_N=20
DPA_RETENTION_DAYS=35
DPA_ENABLE_PLAN_SNAPSHOT=true
DPA_ENABLE_MSSQL_OPS=true
DPA_ENABLE_ADVISORY=true
